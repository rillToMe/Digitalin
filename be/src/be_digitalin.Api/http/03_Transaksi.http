### ALUR MANAJEMEN ADMIN
@admin_token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lsSRDPI5Ej26BQgRCFC0jfoefx_q2HWfzdFQHXx6Yzs


### 1. Buat Pesanan Baru (Checkout dengan Target ID dinamis)
POST {{host}}/orders
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "productId": 23,
  "targetId": "087800001233",
  "zoneId": ""
}

### 2. Cek Riwayat Pesanan Saya
GET {{host}}/orders/my-history
Authorization: Bearer {{customer_token}}
Accept: application/json



### 3. Tembak Ulang (Retry) Pesanan yang Nyangkut (Khusus Admin)
# Pastikan URL menggunakan OrderNo yang statusnya sedang NEEDS_ACTION
POST {{host}}/admin/orders/INV-20260602-ABED/retry
Authorization: Bearer {{admin_token}}
Content-Type: application/json

### 4. Tandai Pesanan sebagai REFUNDED (Khusus Admin)
# Pastikan URL menggunakan OrderNo yang statusnya sedang NEEDS_ACTION
POST {{host}}/admin/orders/INV-20260601-FD64/refund
Authorization: Bearer {{admin_token}}
Content-Type: application/json

### 5. Lihat Semua Pesanan (Pagination & Filter Khusus Admin)
# Coba ubah page=1, limit=5, atau tambahkan &status=NEEDS_ACTION
GET {{host}}/admin/orders?page=1&limit=5
Authorization: Bearer {{admin_token}}
Accept: application/json