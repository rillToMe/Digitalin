@host = http://localhost:5210

### A. ADMIN AUTHENTICATION

# @name loginAdmin
POST {{host}}/admin/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### B. CUSTOMER AUTHENTICATION

POST http://localhost:5210/auth/local/request-otp
Content-Type: application/json

{
  "email": "budi@gmail.com"
}

### 1. Register Pembeli Baru
POST {{host}}/auth/local/register
Content-Type: application/json

{
  "email": "budi1@gmail.com",
  "password": "rahasia123",
  "fullName": "Budi Santoso",
  "otpCode": "75675"
}

### 2. Login Pembeli 
# @name loginCustomer
POST {{host}}/auth/local/login
Content-Type: application/json

{
  "email": "budi1@gmail.com",
  "password": "rahasia123"
}

> {%
    // Skrip ini otomatis jalan setelah dapet response 200 OK
    client.global.set("customer_token", response.body.token);
    client.log("Token Customer berhasil disimpan ke memori global!");
%}

### 3. Google Login
# Ganti idToken dengan token asli dari Google Identity Services (frontend)
# @name loginGoogle
POST {{host}}/auth/google
Content-Type: application/json

{
  "idToken": "PASTE_GOOGLE_ID_TOKEN_HERE"
}

> {%
    if (response.status === 200) {
        client.global.set("customer_token", response.body.token);
        client.log("Token Google Customer berhasil disimpan!");
    }
%}

### C. SECURITY CHECK (TESTING ERROR)

### Test Admin Login Gagal (Password Salah) -> Harusnya 401
POST {{host}}/admin/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "salah_password_123"
}

### Test Akses Tanpa Token -> Harusnya 401
GET {{host}}/orders/my-history
Accept: application/json


### 1. Minta Kode OTP (Cek Mailtrap setelah ini)
POST {{host}}/auth/local/request-otp
Content-Type: application/json

{
  "email": "testaja@gmail.com"
}

### 2. Selesaikan Pendaftaran
# Ganti 123456 dengan 6 angka yang lu dapet dari Mailtrap!
POST {{host}}/auth/local/register
Content-Type: application/json

{
  "email": "testaja@gmail.com",
  "password": "pwtest123!",
  "fullName": "Budi Santoso",
  "otpCode": "34243"
}
### C. FACEBOOK OAUTH LOGIN (authorization code flow, full-page navigation)

# 1. Mulai login Facebook — browser akan di-redirect ke dialog Facebook.
#    (Jangan dipanggil lewat XHR — ini navigasi penuh.)
GET {{host}}/api/v1/auth/facebook/login

# 2. Callback (dipanggil Facebook, bukan manual). Tanpa state valid akan
#    diarahkan ke frontend dengan #error=...
GET {{host}}/api/v1/auth/facebook/callback?code=CONTOH_CODE&state=CONTOH_STATE

# 3. Callback user cancel (error=access_denied) → #error=Login Facebook dibatalkan.
GET {{host}}/api/v1/auth/facebook/callback?error=access_denied
