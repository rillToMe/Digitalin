# ─── Digitalin Frontend — Environment Variables ──────────────────────────────
# Base URL for the Digitalin backend API.
# Default (local development):
VITE_API_BASE_URL=http://localhost:5210

# To test via other devices on LAN (e.g. mobile, tablet), replace with:
# VITE_API_BASE_URL=http://10.15.67.245:5210

# Midtrans Snap client key (sandbox). Required to load the payment popup.
# Get yours from: https://dashboard.midtrans.com/settings/config_info
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxx
